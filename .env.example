# -----------------------------------------------------------------------------
# CodeUnicorn Required Environment Variables
# Copy this file to .env and replace the placeholder values with your own.
# -----------------------------------------------------------------------------

# --- Authentication (Better Auth) ---
# A random cryptographic string used to sign auth tokens.
# Generate one using: openssl rand -base64 32
BETTER_AUTH_SECRET="your_generated_secret_here"

# The base URL of your authentication service
# Example: http://localhost:3000 (if auth is mounted on Next.js frontend)
# Example: http://localhost:4000 (if auth is mounted on Express backend)
BETTER_AUTH_URL="http://localhost:3000"

# --- GitHub OAuth App Credentials ---
# Required for user sign-in and fetching repository data.
# Create this in your GitHub Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# --- AI & Vector Database (RAG) ---
# Required to perform context-aware PR reviews and repository Q&A.
PINECONE_DB_API_KEY="your_pinecone_api_key_here"
GOOGLE_GENERATIVE_AI_API_KEY="your_google_gemini_api_key_here"

# --- Database Setup (PostgreSQL + Prisma) ---
# The connection string for your PostgreSQL database.
# Example: postgresql://postgres:password123@localhost:5432/codeunicorn?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/codeunicorn?schema=public"
